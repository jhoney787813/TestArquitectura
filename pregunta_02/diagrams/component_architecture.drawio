        <mxCell id="edge3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="comp_domain" target="comp_outbox_writer">
          <mxGeometry relative="1" as="geometry" />
