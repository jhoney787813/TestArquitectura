          <mxGeometry x="340" y="500" width="460" height="320" as="geometry" />
        </mxCell>
        <mxCell id="tbl_policies" value="&lt;b&gt;Tabla policies&lt;/b&gt;&lt;br&gt;[SavePolicy] Datos de Póliza" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="c_db">
          <mxGeometry x="30" y="60" width="110" height="120" as="geometry" />
        </mxCell>
        <mxCell id="tbl_local_audit" value="&lt;b&gt;Tabla policy_audit_logs&lt;/b&gt;&lt;br&gt;Auditoría Local (ACID)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="c_db">
          <mxGeometry x="175" y="60" width="110" height="120" as="geometry" />
        </mxCell>
        <mxCell id="tbl_outbox" value="&lt;b&gt;Tabla outbox_events&lt;/b&gt;&lt;br&gt;Eventos Pendientes" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" vertex="1" parent="c_db">
          <mxGeometry x="320" y="60" width="110" height="120" as="geometry" />
        </mxCell>
        <mxCell id="lbl_acid_tx" value="⚡ MISMA TRANSACCIÓN LOCAL ACID (BEGIN ... COMMIT)" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontStyle=1;fontSize=11;" vertex="1" parent="c_db">
          <mxGeometry x="30" y="220" width="400" height="40" as="geometry" />
        </mxCell>

        <!-- CONTENEDOR 4: CAPA DE PROCESAMIENTO ASÍNCRONO -->
        <mxCell id="c_async" value="CAPA ASÍNCRONA &amp; WORKERS (Event-Driven Architecture)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=14;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="860" y="40" width="380" height="780" as="geometry" />
        </mxCell>
        <mxCell id="comp_cdc" value="&lt;b&gt;Outbox Poller / CDC Worker&lt;/b&gt;&lt;br&gt;Lee eventos de outbox_events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="c_async">
