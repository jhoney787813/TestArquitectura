          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Worker -> OpenSearch Audit -->
        <mxCell id="edge12" value="5c. Ingest Central Audit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#990099;" edge="1" parent="1" source="comp_worker" target="comp_opensearch">
