        <mxCell id="comp_web" value="&lt;b&gt;Web / App Móvil&lt;/b&gt;&lt;br&gt;(Cliente Final)&lt;br&gt;&lt;i&gt;Solicita Emisión de Póliza&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="c_client">
          <mxGeometry x="30" y="60" width="180" height="120" as="geometry" />
        </mxCell>

        <!-- CONTENEDOR 2: API GATEWAY & CORE BACKEND -->
