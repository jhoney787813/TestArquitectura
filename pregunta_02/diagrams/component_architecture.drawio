              <mxPoint x="340" y="100" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Outbox Table -> Outbox Poller -->
        <mxCell id="edge6" value="4. Polling Outbox Events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#FF8000;" edge="1" parent="1" source="tbl_outbox" target="comp_cdc">
          <mxGeometry relative="1" as="geometry">
