          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Worker -> Retry -> DLQ -->
        <mxCell id="edge9" value="Falla Email" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1;dashed=1;strokeColor=#CC0000;" edge="1" parent="1" source="comp_retry" target="comp_dlq">
          <mxGeometry relative="1" as="geometry" />
