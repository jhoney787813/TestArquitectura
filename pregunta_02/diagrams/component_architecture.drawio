          <mxGeometry x="1290" y="40" width="270" height="780" as="geometry" />
        </mxCell>
        <mxCell id="gw_email" value="&lt;b&gt;Email Service (SMTP)&lt;/b&gt;&lt;br&gt;SendEmail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="c_external">
          <mxGeometry x="30" y="160" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gw_sms" value="&lt;b&gt;SMS Provider Gateway&lt;/b&gt;&lt;br&gt;SendSMS (Telefonía)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="c_external">
          <mxGeometry x="30" y="280" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gw_push" value="&lt;b&gt;Fallback Push / In-App&lt;/b&gt;&lt;br&gt;(Notificación Alternativa)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="c_external">
          <mxGeometry x="30" y="380" width="210" height="60" as="geometry" />
        </mxCell>

        <!-- CONEXIONES Y FLECHAS -->
        <!-- Client -> API -->
        <mxCell id="edge1" value="1. POST /policies/emit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#0066CC;" edge="1" parent="1" source="comp_web" target="comp_api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- API -> Domain -> Outbox Writer -->
        <mxCell id="edge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="comp_api" target="comp_domain">
          <mxGeometry relative="1" as="geometry" />
