        </mxCell>
        <mxCell id="comp_cb" value="&lt;b&gt;Circuit Breaker&lt;/b&gt;&lt;br&gt;(Polly / Resilience4j)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="c_async">
          <mxGeometry x="210" y="280" width="140" height="60" as="geometry" />
        </mxCell>

        <mxCell id="comp_dlq" value="&lt;b&gt;Dead Letter Queue (DLQ)&lt;/b&gt;&lt;br&gt;Cola de eventos fallidos retenidos" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=11;" vertex="1" parent="c_async">
