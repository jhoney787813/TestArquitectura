        <!-- Poller -> Worker -->
        <mxCell id="edge7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="comp_cdc" target="comp_worker">
          <mxGeometry relative="1" as="geometry" />
