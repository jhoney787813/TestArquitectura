        </mxCell>
        <mxCell id="comp_opensearch" value="&lt;b&gt;ElasticSearch / OpenSearch Cluster&lt;/b&gt;&lt;br&gt;Auditoría Centralizada Append-Only" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;" vertex="1" parent="c_async">
          <mxGeometry x="30" y="550" width="320" height="100" as="geometry" />
        </mxCell>

        <!-- CONTENEDOR 5: GATEWAYS EXTERNOS -->
