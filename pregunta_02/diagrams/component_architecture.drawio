        <!-- Outbox Writer -> DB Tables -->
        <mxCell id="edge4" value="2. ACID Commit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#00994C;" edge="1" parent="1" source="comp_outbox_writer" target="lbl_acid_tx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- API -> Client Response -->
