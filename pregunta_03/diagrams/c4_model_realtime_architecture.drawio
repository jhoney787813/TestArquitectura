<mxfile host="app.diagrams.net" modified="2026-08-19T14:18:00.000Z" agent="Antigravity Senior Architect" version="21.0.0" type="device">
  <diagram id="c4-realtime-arch" name="C4 Model Level 2 - Container Diagram Real-Time Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- C4 BOUNDARY: REAL-TIME INSURANCE SYSTEM -->
        <mxCell id="c4_boundary" value="Sistema de Rastreo en Tiempo Real (Real-Time Insurance System Boundary)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#000000;fontStyle=1;fontSize=16;startSize=40;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1520" height="880" as="geometry" />
        </mxCell>

        <!-- PERSON / ACTOR -->
        <mxCell id="actor_user" value="&lt;b&gt;[Person]&lt;/b&gt;&lt;br&gt;&lt;b&gt;Cliente / Perito / Asegurado&lt;/b&gt;&lt;br&gt;&lt;i&gt;Visualiza estados de Emisión, Inspección y Siniestros en vivo&lt;/i&gt;" style="html=1;whiteSpace=wrap;fillColor=#08427b;strokeColor=#073866;fontColor=#ffffff;shape=mxgraph.c4.person;align=center;fontSize=12;" vertex="1" parent="c4_boundary">
          <mxGeometry x="40" y="80" width="200" height="140" as="geometry" />
        </mxCell>

        <!-- CONTAINER 1: CLIENT FRONTEND -->
        <mxCell id="c4_client" value="&lt;b&gt;[Container: Single Page Application / Mobile App]&lt;/b&gt;&lt;br&gt;&lt;b&gt;Live Status Dashboard UI&lt;/b&gt;&lt;br&gt;&lt;i&gt;React / Angular / Flutter&lt;/i&gt;&lt;br&gt;Suscrito a eventos mediante SSE y SignalR WebSockets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;strokeColor=#0e5296;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="c4_boundary">
          <mxGeometry x="320" y="90" width="300" height="120" as="geometry" />
        </mxCell>

        <!-- CONTAINER 2: REAL-TIME SIGNALR / SSE GATEWAY -->
        <mxCell id="c4_gateway" value="&lt;b&gt;[Container: Microservice API]&lt;/b&gt;&lt;br&gt;&lt;b&gt;Real-Time SignalR &amp; SSE Gateway&lt;/b&gt;&lt;br&gt;&lt;i&gt;.NET Core SignalR / FastAPI Hub&lt;/i&gt;&lt;br&gt;Mantiene conexiones persistentes HTTP/2 SSE y WebSockets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;strokeColor=#0e5296;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="c4_boundary">
          <mxGeometry x="720" y="90" width="340" height="120" as="geometry" />
        </mxCell>

        <!-- CONTAINER 3: REDIS PUB/SUB BACKPLANE -->
        <mxCell id="c4_redis" value="&lt;b&gt;[Container: In-Memory Datastore]&lt;/b&gt;&lt;br&gt;&lt;b&gt;Redis Pub/Sub Backplane&lt;/b&gt;&lt;br&gt;&lt;i&gt;Redis Cluster v7.0&lt;/i&gt;&lt;br&gt;Sincroniza mensajes del Hub entre múltiples nodos del Gateway" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#85bbf0;strokeColor=#0e5296;fontColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="c4_boundary">
          <mxGeometry x="1160" y="80" width="300" height="140" as="geometry" />
        </mxCell>

        <!-- CONTAINER 4: KAFKA CLUSTER (EVENT BACKBONE) -->
        <mxCell id="c4_kafka" value="&lt;b&gt;[Container: Event Streaming Platform]&lt;/b&gt;&lt;br&gt;&lt;b&gt;Apache Kafka Event Backbone&lt;/b&gt;&lt;br&gt;&lt;i&gt;Topics: policy-events, inspection-events, claims-events&lt;/i&gt;&lt;br&gt;Almacena streams ordenados de eventos de dominio con alta concurrencia" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#1168bd;strokeColor=#0e5296;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="c4_boundary">
          <mxGeometry x="720" y="340" width="340" height="160" as="geometry" />
        </mxCell>

        <!-- CONTAINER 5: CORE PRODUCER MICROSERVICES -->
        <mxCell id="c4_producers" value="CORE PRODUCERS (Sistemas Origen de Eventos)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#e9ecef;strokeColor=#495057;fontStyle=1;fontSize=13;startSize=30;" vertex="1" parent="c4_boundary">
          <mxGeometry x="40" y="560" width="1420" height="260" as="geometry" />
        </mxCell>

        <mxCell id="svc_emision" value="&lt;b&gt;Policy Emission Service&lt;/b&gt;&lt;br&gt;Publica: POLICY_EMITTED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2b7bba;strokeColor=#0e5296;fontColor=#ffffff;fontSize=11;" vertex="1" parent="c4_producers">
          <mxGeometry x="40" y="70" width="280" height="120" as="geometry" />
        </mxCell>

        <mxCell id="svc_inspeccion" value="&lt;b&gt;Inspection Service&lt;/b&gt;&lt;br&gt;Publica: INSPECTOR_ON_WAY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2b7bba;strokeColor=#0e5296;fontColor=#ffffff;fontSize=11;" vertex="1" parent="c4_producers">
          <mxGeometry x="400" y="70" width="280" height="120" as="geometry" />
        </mxCell>

        <mxCell id="svc_siniestros" value="&lt;b&gt;Claims &amp; Incidents Service&lt;/b&gt;&lt;br&gt;Publica: CLAIM_FILED / TOW_TRUCK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2b7bba;strokeColor=#0e5296;fontColor=#ffffff;fontSize=11;" vertex="1" parent="c4_producers">
          <mxGeometry x="760" y="70" width="280" height="120" as="geometry" />
        </mxCell>

        <mxCell id="svc_audit" value="&lt;b&gt;Centralized Audit Consumer&lt;/b&gt;&lt;br&gt;Ingesta trazas a OpenSearch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6c757d;strokeColor=#343a40;fontColor=#ffffff;fontSize=11;" vertex="1" parent="c4_producers">
          <mxGeometry x="1100" y="70" width="280" height="120" as="geometry" />
        </mxCell>

        <!-- FLECHAS C4 CON DESCRIPCIÓN DE PROTOCOLOS -->
        <mxCell id="flow1" value="Visualiza Dashboard (HTTPS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#08427b;" edge="1" parent="c4_boundary" source="actor_user" target="c4_client">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="flow2" value="Suscripción SSE (HTTP/2) &amp; WebSockets (TCP)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#1168bd;" edge="1" parent="c4_boundary" source="c4_client" target="c4_gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="flow3" value="Scale-out Backplane (Pub/Sub)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#0e5296;dashed=1;" edge="1" parent="c4_boundary" source="c4_gateway" target="c4_redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="flow4" value="Consume Event Streams" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#1168bd;" edge="1" parent="c4_boundary" source="c4_kafka" target="c4_gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="flow5" value="1. Publica Eventos Emisión" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#2b7bba;" edge="1" parent="c4_boundary" source="svc_emision" target="c4_kafka">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="flow6" value="2. Publica Eventos Inspección" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#2b7bba;" edge="1" parent="c4_boundary" source="svc_inspeccion" target="c4_kafka">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="flow7" value="3. Publica Eventos Siniestros" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#2b7bba;" edge="1" parent="c4_boundary" source="svc_siniestros" target="c4_kafka">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
